<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Chúc mừng sinh nhật!</title>
  <style>
    body {
      background-color: #fffbe6;
      font-family: 'Segoe UI', sans-serif;
      text-align: center;
      padding: 30px;
      color: #333;
    }

    h1 {
      color: #e91e63;
      font-size: 48px;
    }

    p {
      font-size: 24px;
      margin-top: 20px;
    }

    .image-row {
      display: flex;
      flex-direction: row;
      gap: 15px;
      margin-top: 40px;
      overflow-x: auto;
      padding-bottom: 20px;
    }

    .image-row img {
      height: 200px;
      border-radius: 15px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.2);
      flex-shrink: 0;
    }

    audio {
      display: none;
    }

    /* Thanh cuộn ngang đẹp hơn */
    .image-row::-webkit-scrollbar {
      height: 10px;
    }

    .image-row::-webkit-scrollbar-thumb {
      background-color: #ffb6c1;
      border-radius: 10px;
    }

    .image-row::-webkit-scrollbar-track {
      background-color: #ffe4e1;
    }
  </style>
</head>
<body>
  <h1>🎉 Chúc mừng sinh nhật 🎉</h1>
  <p>Chúc bạn luôn rạng rỡ, hạnh phúc, và tràn đầy năng lượng tích cực! 💖</p>

  <!-- Hàng ảnh ngang -->
  <div class="image-row">
    <img src="anh1.jpg" alt="Ảnh 1">
    <img src="anh2.jpg" alt="Ảnh 2">
    <img src="anh3.jpg" alt="Ảnh 3">
    <img src="anh4.jpg" alt="Ảnh 4">
    <img src="anh5.jpg" alt="Ảnh 5">
    <img src="anh6.jpg" alt="Ảnh 6">
    <img src="anh7.jpg" alt="Ảnh 7">
    <img src="anh8.jpg" alt="Ảnh 8">
    <img src="anh9.jpg" alt="Ảnh 9">
    <img src="anh10.jpg" alt="Ảnh 10">
    <img src="anh11.jpg" alt="Ảnh 11">
    <img src="anh12.jpg" alt="Ảnh 12">
    <img src="anh13.jpg" alt="Ảnh 13">
    <img src="anh14.jpg" alt="Ảnh 14">
    <img src="anh15.jpg" alt="Ảnh 15">
    <img src="anh16.jpg" alt="Ảnh 16">
  </div>

  <!-- Nhạc nền -->
  <audio autoplay loop>
    <source src="nhac.mp3" type="audio/mpeg">
    Trình duyệt của bạn không hỗ trợ phát nhạc.
  </audio>
</body>
</html>
